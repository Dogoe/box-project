# Copy this file to ".env" (same folder) and fill in your values. ".env" is git-ignored:
# never commit real keys. Spring Boot reads it when you run the app locally (IntelliJ or
# gradle bootRun from this folder), and docker compose reads it too.
#
# For local development everything is optional: without a value the app uses the local
# defaults in application.yml (local Postgres "dbbox", admin@bajasolarsupply.com / admin123...).
# In production (Render) the same names go in Render > Environment; see DEPLOY.md.

# ---- Profile ----
# Leave unset locally. "prod" in production: then the values marked REQUIRED must be set,
# and the app refuses to start with the development defaults.
# SPRING_PROFILES_ACTIVE=prod

# ---- Database (REQUIRED in prod) ----
# Neon: from "Connection string" (direct, without "-pooler"), rewritten as JDBC:
#   postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
#   -> DB_URL=jdbc:postgresql://HOST/neondb?sslmode=require, DB_USERNAME=USER, DB_PASSWORD=PASSWORD
# DB_URL=jdbc:postgresql://localhost:5432/dbbox
# DB_USERNAME=postgres
# DB_PASSWORD=admin

# ---- Login sessions (REQUIRED in prod) ----
# A long random value, at least 32 characters. Generate one with:
#   macOS/Linux/Git Bash:  openssl rand -base64 48
#   Windows PowerShell:    $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Changing it signs everyone out. (On Render, render.yaml generates it for you.)
# JWT_SECRET=

# ---- First admin (REQUIRED in prod) ----
# Created on the first start if that email has no account yet. Changing these afterwards does
# NOT change the existing admin. Password: at least 12 characters.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# ---- Public address ----
# https address of the site, used for links in emails. On Render it defaults to the
# onrender.com address; set it when your domain is connected.
# PUBLIC_BASE_URL=https://bajasolarsupply.com

# ---- Email ----
# Locally, without these, emails go to MailHog (docker compose; see them at http://localhost:8025)
# and nobody receives them. Fill them in to send real emails from your machine too.
# false = don't send emails at all (orders still work). Useful while testing.
# MAIL_ENABLED=false
# Brevo: smtp-relay.brevo.com + the "Login" from Brevo > SMTP & API > SMTP (looks like
#        xxxx@smtp-brevo.com, not your email) + the SMTP key.
# Gmail: smtp.gmail.com + your Gmail address + a 16-character App Password.
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=Baja Solar Supply <pedidos@bajasolarsupply.com>

# ---- Cloudflare R2 (product and kit photos) ----
# R2 > your bucket > Settings > "S3 API": https://<ACCOUNT_ID>.r2.cloudflarestorage.com (without /box-app-images)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=box-app-images
# From R2 > Manage API Tokens (Object Read & Write, only this bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 > your bucket > Settings > Public access > "Public Development URL" (r2.dev), later your own domain
R2_PUBLIC_URL=https://pub-XXXXXXXX.r2.dev
