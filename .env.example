# Copy this file to ".env" (same folder) and fill in your values. ".env" is git-ignored:
# never commit real keys. Spring Boot reads it when you run the app locally (IntelliJ or
# gradle bootRun from this folder), and docker compose reads it too.

# ---- Cloudflare R2 (product and kit photos) ----
# R2 > your bucket > Settings > "S3 API": https://<ACCOUNT_ID>.r2.cloudflarestorage.com (without /box-app-images)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=box-app-images
# From R2 > Manage API Tokens (Object Read & Write, only this bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 > your bucket > Settings > Public access > "Public Development URL" (r2.dev), later your own domain
R2_PUBLIC_URL=https://pub-XXXXXXXX.r2.dev
